<Window x:Class="ChitaiGorodApp.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «ЧитайГород» — Заказы" Height="620" Width="980"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#ABCFCE" Padding="15,8">
            <Grid>
                <TextBlock Text="Управление заказами" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="Назад к товарам" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BackBtn_Click"/>
            </Grid>
        </Border>

        <ListBox x:Name="OrdersListBox" Grid.Row="1" Margin="10" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="OrdersListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#ABCFCE" BorderThickness="1.5" CornerRadius="4" Margin="0,5" Padding="10" Background="White">
                        <Border.ToolTip>
                            <ToolTip Content="{Binding ClientFullName, StringFormat='Клиент: {0}'}"/>
                        </Border.ToolTip>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#ABCFCE" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,10,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="Артикул заказа: "/>
                                        <Run Text="{Binding ArticlesSummary}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusName, StringFormat='Статус заказа: {0}'}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PickupAddress, StringFormat='Адрес пункта выдачи: {0}'}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat='Дата заказа: {0:dd.MM.yyyy}'}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="#ABCFCE" BorderThickness="1" CornerRadius="3" Padding="12" VerticalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Дата доставки" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding DeliveryDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="AdminOrderPanel" Grid.Row="2" Background="#ABCFCE" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Добавить заказ" Click="AddOrderBtn_Click" Margin="0,0,10,0"/>
                <Button Content="Удалить заказ" Background="#A83232" Click="DeleteOrderBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>