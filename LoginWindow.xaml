<Window x:Class="ChitaiGorodApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ЧитайГород — Авторизация" Height="380" Width="440"
        WindowStartupLocation="CenterScreen" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="350"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="#ABCFCE" Padding="15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="picture.png" Height="45" Stretch="Uniform" Margin="0,0,12,0"/>
                <TextBlock Text="ООО «ЧитайГород»" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="35,20">
            <TextBlock Text="Вход в информационную систему" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Логин:" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginBox" Height="30" Margin="0,0,0,12"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="30" Margin="0,0,0,18"/>

            <Button Content="Войти" Height="34" FontWeight="Bold" Click="LoginButton_Click" Margin="0,0,0,10"/>
            <Button Content="Продолжить как гость" Height="32" Background="#ABCFCE" Foreground="Black" Click="GuestButton_Click"/>
        </StackPanel>
    </Grid>
</Window>