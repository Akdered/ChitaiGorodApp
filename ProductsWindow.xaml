<Window x:Class="ChitaiGorodApp.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «ЧитайГород» — Список товаров" Height="720" Width="1150"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#ABCFCE" Padding="15,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="picture.png" Height="42" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="Каталог товаров — ООО «ЧитайГород»" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserInfoText" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Выйти" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="FilterPanel" Grid.Row="1" Background="#F5F8F8" Padding="15,10" BorderBrush="#ABCFCE" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="Поиск по товарам:" FontSize="12"/>
                    <TextBox x:Name="SearchBox" Width="260" Height="28" TextChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="Сортировка:" FontSize="12"/>
                    <ComboBox x:Name="SortComboBox" Width="230" Height="28" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                        <ComboBoxItem Content="Цена: по возрастанию"/>
                        <ComboBoxItem Content="Цена: по убыванию"/>
                        <ComboBoxItem Content="Остаток: по возрастанию"/>
                        <ComboBoxItem Content="Остаток: по убыванию"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="Фильтр по скидке:" FontSize="12"/>
                    <ComboBox x:Name="DiscountFilterComboBox" Width="180" Height="28" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="Все диапазоны" IsSelected="True"/>
                        <ComboBoxItem Content="0-12,99%"/>
                        <ComboBoxItem Content="13-16,99%"/>
                        <ComboBoxItem Content="17% и более"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="CountText" VerticalAlignment="Bottom" Margin="10,0,0,8" FontWeight="Bold"/>
            </WrapPanel>
        </Border>

        <ListBox x:Name="ProductsListBox" Grid.Row="2" Margin="10" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="ProductsListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#ABCFCE" BorderThickness="1.5" CornerRadius="4" Margin="0,5" Padding="10"
                            Background="{Binding RowBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#ABCFCE" BorderThickness="1" CornerRadius="3" Margin="0,0,10,0"
                                    VerticalAlignment="Stretch" Padding="8">
                                <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White" Width="140" Height="110"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding ProductImage}" Stretch="Uniform"/>
                                </Border>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="#ABCFCE" BorderThickness="1" CornerRadius="3" Margin="0,0,10,0"
                                    VerticalAlignment="Stretch" Padding="12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="15" FontWeight="Bold" Margin="0,0,0,6">
                                        <Run Text="{Binding CategoryName}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding DescriptionDisplay}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ManufacturerName, StringFormat='Производитель: {0}'}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SupplierName, StringFormat='Поставщик: {0}'}" Margin="0,0,0,4"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Цена: "/>
                                        <TextBlock Text="{Binding OldPriceDisplay}" Visibility="{Binding OldPriceVisibility}"
                                                   Foreground="Red" TextDecorations="Strikethrough" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding PriceDisplay}" Foreground="Black" FontWeight="Bold"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding UnitName, StringFormat='Единица измерения: {0}'}" Margin="0,0,0,4"/>

                                    <TextBlock Text="{Binding StockQuantity, StringFormat='Количество на складе: {0}'}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="#ABCFCE" BorderThickness="1" CornerRadius="3"
                                    VerticalAlignment="Stretch" Padding="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Действующая скидка" FontSize="13" HorizontalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Discount, StringFormat='{}{0}%'}" FontSize="24" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="BottomPanel" Grid.Row="3" Background="#ABCFCE" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OrdersBtn" Content="Заказы" Click="OrdersBtn_Click" Margin="0,0,10,0"/>
                <Button x:Name="AddProductBtn" Content="Добавить товар" Click="AddProductBtn_Click" Margin="0,0,10,0"/>
                <Button x:Name="DeleteProductBtn" Content="Удалить товар" Background="#A83232" Click="DeleteProductBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>